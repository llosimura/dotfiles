#!/usr/bin/env bash
set -euo pipefail

echo "==> Bootstrapping dotfiles..."

# 1. Install Homebrew if missing
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# 2. Install chezmoi if missing
if ! command -v chezmoi &>/dev/null; then
  echo "==> Installing chezmoi..."
  brew install chezmoi
fi

# 3. Apply chezmoi dotfiles
echo "==> Applying chezmoi dotfiles..."
chezmoi apply

# 4. Install devbox if missing
if ! command -v devbox &>/dev/null; then
  echo "==> Installing devbox..."
  curl -fsSL https://get.jetify.com/devbox | bash
fi

# 5. Install devbox global packages
echo "==> Installing devbox global packages..."
devbox global install

# 6. Install Homebrew bundles
echo "==> Installing Homebrew bundle..."
brew bundle --file="$(chezmoi source-path)/Brewfile"

# 7. Install zellij plugins
echo "==> Installing zellij plugins..."
ZELLIJ_PLUGINS_DIR="$HOME/.config/zellij/plugins"
mkdir -p "$ZELLIJ_PLUGINS_DIR"
curl -L "https://github.com/rvcas/room/releases/latest/download/room.wasm" -o "$ZELLIJ_PLUGINS_DIR/room.wasm"
curl -L "https://github.com/karimould/zellij-forgot/releases/latest/download/zellij_forgot.wasm" -o "$ZELLIJ_PLUGINS_DIR/zellij_forgot.wasm"
curl -L "https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" -o "$ZELLIJ_PLUGINS_DIR/zjstatus-v0.22.0.wasm"
curl -L "https://github.com/ndavd/zellij-pane-picker/releases/latest/download/zellij-pane-picker.wasm" -o "$ZELLIJ_PLUGINS_DIR/zellij-pane-picker-v0.6.0.wasm"

# 8. Install yazi plugins
echo "==> Installing yazi plugins..."
ya pkg install

echo "==> Bootstrap complete."
